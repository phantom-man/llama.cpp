{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Read|Bash",
          "hooks": [
            {
              "type": "process",
              "command": "powershell.exe",
              "enabled": true,
              "statusMessage": "G6 guard: jCodemunch-first (Read/Bash-search)",
              "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "tools/zcode_jcm_guard.ps1",
                "-SessionId",
                "${CLAUDE_SESSION_ID}"
              ],
              "timeoutMs": 15000
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Skill|mcp__(plugin_jcodemunch_jcodemunch|jcodemunch)__.*",
          "hooks": [
            {
              "type": "process",
              "command": "powershell.exe",
              "enabled": true,
              "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "tools/zcode_jcm_mark.ps1",
                "-SessionId",
                "${CLAUDE_SESSION_ID}"
              ],
              "timeoutMs": 15000
            }
          ]
        }
      ]
    }
  }
}
